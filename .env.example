# ============================================================
# Agentic RAG RCA Tool — environment configuration
# Copy this file to .env and fill in your own values:
#     copy .env.example .env
# ============================================================

# --- Dashboard -----------------------------------------------
# URL of your hosted product-metrics dashboard (Vercel or localhost).
# The tool polls {DASHBOARD_URL}/api/metrics/live every 10 seconds.
DASHBOARD_URL=https://your-dashboard.vercel.app

# --- LLM providers -------------------------------------------
# Groq (primary LLM, llama-3.3-70b-versatile). Free key: https://console.groq.com
GROQ_API_KEY=gsk_...

# Google AI Studio (fallback LLM gemini-2.5-flash-lite + the embedding model).
# One key covers both. Free key: https://aistudio.google.com
GEMINI_API_KEY=AIza...

# --- Vector database -----------------------------------------
# Pinecone (stores chunked sample RCA reports for semantic retrieval).
# Free key, no credit card: https://app.pinecone.io
PINECONE_API_KEY=pcsk_...

# --- Postgres database ---------------------------------------
# Neon serverless Postgres (stores generated reports + run history).
# Free, no credit card: https://console.neon.tech
# Create a project, then copy the connection string from the dashboard.
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# --- Email (OPTIONAL — only for the "Send via Email" button) --
# Use a Gmail App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-app-password
REPORT_EMAIL_TO=recipient@example.com
